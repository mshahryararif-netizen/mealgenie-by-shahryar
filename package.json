{
  "name": "mealgenie",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:generate": "dotenv -e .env.local --override -- prisma generate",
    "db:push": "dotenv -e .env.local --override -- prisma db push",
    "db:migrate": "dotenv -e .env.local --override -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e .env.local --override -- prisma migrate deploy",
    "db:verify": "dotenv -e .env.local --override -- node scripts/verify-db.mjs",
    "db:studio": "dotenv -e .env.local --override -- prisma studio",
    "mobile:sync": "npx cap sync android",
    "mobile:icons": "npx capacitor-assets generate --android --iconBackgroundColor \"#000000\" --iconBackgroundColorDark \"#000000\" --splashBackgroundColor \"#000000\" --splashBackgroundColorDark \"#000000\" --assetPath mobile/resources",
    "mobile:open": "npx cap open android",
    "mobile:apk": "cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@clerk/nextjs": "^7.5.8",
    "@prisma/client": "^6.19.3",
    "framer-motion": "^13.0.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.19.3",
    "sharp": "^0.35.3",
    "typescript": "^5.7.0"
  }
}
