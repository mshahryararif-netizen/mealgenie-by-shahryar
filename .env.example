# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key

# Clerk route URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_OUT_FALLBACK_REDIRECT_URL=/sign-in

# PostgreSQL (Neon via Vercel integration — https://neon.tech)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Server-side API keys (never expose to the client)
OPENROUTER_API_KEY=
SPOONACULAR_API_KEY=

# Canonical site URL (used for metadata / OpenRouter attribution)
NEXT_PUBLIC_APP_URL=https://mealgenie.komyosys.ai
OPENROUTER_SITE_URL=https://mealgenie.komyosys.ai

# Optional: enable Google OAuth in the Clerk Dashboard → User & Authentication → Social connections
